{
  "info": {
    "name": "Microservices API Gateway - Full Test Suite",
    "description": "Test all APIs through API Gateway (port 8080). First get token via /auth/access-token, then use Bearer token for other APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4953", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "username", "value": "sysadmin", "type": "string" },
    { "key": "password", "value": "password", "type": "string" },
    { "key": "order_id", "value": "", "type": "string" },
    { "key": "product_id", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Authentication Service",
      "item": [
        {
          "name": "1. Login - Get Access & Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"platform\": \"web\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/auth/access-token", "host": ["{{base_url}}"], "path": ["auth", "access-token"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status 200\", () => pm.response.code === 200);",
                "const json = pm.response.json();",
                "if (json.data?.accessToken) {",
                "  pm.environment.set(\"access_token\", json.data.accessToken);",
                "  pm.environment.set(\"refresh_token\", json.data.refreshToken);",
                "  console.log(\"✅ Token saved\");",
                "}"
              ]
            }
          }]
        },
        {
          "name": "2. Refresh Access Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{{refresh_token}}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/auth/refresh-token", "host": ["{{base_url}}"], "path": ["auth", "refresh-token"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status 200\", () => pm.response.code === 200);",
                "const json = pm.response.json();",
                "if (json.data?.accessToken) pm.environment.set(\"access_token\", json.data.accessToken);"
              ]
            }
          }]
        },
        {
          "name": "3. Verify Token (gRPC via Gateway)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "\"{{access_token}}\"", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/auth/verify-token", "host": ["{{base_url}}"], "path": ["auth", "verify-token"] }
          }
        }
      ]
    },
    {
      "name": "👤 Account Service (User Management)",
      "item": [
        {
          "name": "1. Get User List",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/account/user/list?page=0&size=10", "host": ["{{base_url}}"], "path": ["account", "user", "list"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] } }
        },
        {
          "name": "2. Get User Detail",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/account/user/id/{{user_id}}", "host": ["{{base_url}}"], "path": ["account", "user", "id", "{{user_id}}"] } }
        },
        {
          "name": "3. Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"dateOfBirth\": \"2000-01-01\",\n  \"gender\": \"MALE\",\n  \"phone\": \"0987654321\",\n  \"email\": \"testuser@email.com\",\n  \"username\": \"testuser\",\n  \"password\": \"12345678\",\n  \"status\": \"ACTIVE\",\n  \"type\": \"USER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/account/user/add", "host": ["{{base_url}}"], "path": ["account", "user", "add"] }
          }
        },
        {
          "name": "4. Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{user_id}},\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"phone\": \"0987654321\",\n  \"email\": \"updated@email.com\",\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/account/user/update", "host": ["{{base_url}}"], "path": ["account", "user", "update"] }
          }
        },
        {
          "name": "5. Change Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{user_id}},\n  \"oldPassword\": \"12345678\",\n  \"newPassword\": \"newpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/account/user/change-password", "host": ["{{base_url}}"], "path": ["account", "user", "change-password"] }
          }
        },
        {
          "name": "6. Delete User",
          "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/account/user/{{user_id}}", "host": ["{{base_url}}"], "path": ["account", "user", "{{user_id}}"] } }
        }
      ]
    },
    {
      "name": "📦 Product Service",
      "item": [
        {
          "name": "1. Get Product List",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/product/list?name=shoe", "host": ["{{base_url}}"], "path": ["product", "list"], "query": [{ "key": "name", "value": "shoe" }] } }
        },
        {
          "name": "2. Get Product Detail",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/product/{{product_id}}", "host": ["{{base_url}}"], "path": ["product", "{{product_id}}"] } }
        },
        {
          "name": "3. Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nike Air Max\",\n  \"description\": \"Running shoes\",\n  \"price\": 2500000,\n  \"quantity\": 100,\n  \"categoryId\": 1,\n  \"brandId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/product/add", "host": ["{{base_url}}"], "path": ["product", "add"] }
          }
        },
        {
          "name": "4. Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{product_id}},\n  \"name\": \"Nike Air Max Updated\",\n  \"description\": \"Updated running shoes\",\n  \"price\": 2800000,\n  \"quantity\": 80\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/product/update", "host": ["{{base_url}}"], "path": ["product", "update"] }
          }
        },
        {
          "name": "5. Delete Product",
          "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/product/{{product_id}}", "host": ["{{base_url}}"], "path": ["product", "{{product_id}}"] } }
        }
      ]
    },
    {
      "name": "🛒 Order Service",
      "item": [
        {
          "name": "1. Get Order List",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/order/list?page=0&size=10", "host": ["{{base_url}}"], "path": ["order", "list"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] } }
        },
        {
          "name": "2. Get Order Detail",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/order/{{order_id}}", "host": ["{{base_url}}"], "path": ["order", "{{order_id}}"] } }
        },
        {
          "name": "3. Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 2 },\n    { \"productId\": 2, \"quantity\": 1 }\n  ],\n  \"shippingAddress\": \"123 Main St, Hanoi\",\n  \"paymentMethod\": \"CARD\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/order/add", "host": ["{{base_url}}"], "path": ["order", "add"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["const json = pm.response.json(); if (json.data) pm.environment.set(\"order_id\", json.data);"] }
          }]
        },
        {
          "name": "4. Update Order",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{order_id}}\",\n  \"status\": \"PENDING\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/order/upd", "host": ["{{base_url}}"], "path": ["order", "upd"] }
          }
        },
        {
          "name": "5. Checkout Order",
          "request": { "method": "PATCH", "url": { "raw": "{{base_url}}/order/checkout/{{order_id}}", "host": ["{{base_url}}"], "path": ["order", "checkout", "{{order_id}}"] } }
        },
        {
          "name": "6. Cancel Order",
          "request": { "method": "PATCH", "url": { "raw": "{{base_url}}/order/cancel/{{order_id}}", "host": ["{{base_url}}"], "path": ["order", "cancel", "{{order_id}}"] } }
        },
        {
          "name": "7. Generate QR Code",
          "request": { "method": "POST", "url": { "raw": "{{base_url}}/order/qrcode?text=https://example.com/pay/123", "host": ["{{base_url}}"], "path": ["order", "qrcode"], "query": [{ "key": "text", "value": "https://example.com/pay/123" }] } }
        }
      ]
    },
    {
      "name": "💳 Payment Service",
      "item": [
        {
          "name": "1. Create Payment Intent (Stripe)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"orderId\": \"{{order_id}}\",\n  \"paymentMethod\": \"CARD\",\n  \"amount\": 5000000,\n  \"currency\": \"VND\",\n  \"description\": \"Payment for order {{order_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/payment/create-payment-intent", "host": ["{{base_url}}"], "path": ["payment", "create-payment-intent"] }
          }
        },
        {
          "name": "2. Charge Card",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"tok_visa\",\n  \"amount\": 5000000,\n  \"currency\": \"vnd\",\n  \"description\": \"Charge for order {{order_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/payment/charge", "host": ["{{base_url}}"], "path": ["payment", "charge"] }
          }
        },
        {
          "name": "3. Confirm Payment",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/payment/confirm-payment?paymentIntentId=pi_xxx", "host": ["{{base_url}}"], "path": ["payment", "confirm-payment"], "query": [{ "key": "paymentIntentId", "value": "pi_xxx" }] }
          }
        },
        {
          "name": "4. Create Refund",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/payment/refund?paymentIntentId=pi_xxx", "host": ["{{base_url}}"], "path": ["payment", "refund"], "query": [{ "key": "paymentIntentId", "value": "pi_xxx" }] }
          }
        }
      ]
    },
    {
      "name": "📦 Inventory Service",
      "item": [
        {
          "name": "1. Search Inventory",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/inventory/search?productId=1", "host": ["{{base_url}}"], "path": ["inventory", "search"], "query": [{ "key": "productId", "value": "1" }] } }
        }
      ]
    },
    {
      "name": "🔔 Notification Service",
      "item": [
        {
          "name": "1. Send Push Notification (OneSignal)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerIds\": [\"player_id_1\", \"player_id_2\"],\n  \"message\": \"Hello from Microservices!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/notification/send", "host": ["{{base_url}}"], "path": ["notification", "send"] }
          }
        }
      ]
    },
    {
      "name": "🛡️ Authorization Service (Role/Permission)",
      "item": [
        {
          "name": "1. Get Roles by Username",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/author/roles?username={{username}}", "host": ["{{base_url}}"], "path": ["author", "roles"], "query": [{ "key": "username", "value": "{{username}}" }] } }
        },
        {
          "name": "2. Get Permissions by Role ID",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/author/1/permissions", "host": ["{{base_url}}"], "path": ["author", "1", "permissions"] } }
        },
        {
          "name": "3. Check Permission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"path\": \"GET /product/list\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/author/check-permissions", "host": ["{{base_url}}"], "path": ["author", "check-permissions"] }
          }
        }
      ]
    },
    {
      "name": "📧 Mail Service",
      "item": [
        {
          "name": "1. Send Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"recipient@email.com\",\n  \"subject\": \"Test Email\",\n  \"body\": \"<h1>Hello from Microservices!</h1><p>This is a test email.</p>\",\n  \"isHtml\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/mail/send", "host": ["{{base_url}}"], "path": ["mail", "send"] }
          }
        }
      ]
    }
  ]
}