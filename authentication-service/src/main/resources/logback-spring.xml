<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Read application name from Spring properties -->
    <springProperty scope="context" name="springAppName" source="spring.application.name" defaultValue="authentication-service"/>

    <!-- Console Appender -->
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] [${springAppName},%X{traceId:-},%X{spanId:-}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File Appender -->
    <appender name="File" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] [${springAppName},%X{traceId:-},%X{spanId:-}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ELK (Logstash) Appender -->
    <appender name="ELK" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${LOGSTASH_HOST:-localhost:5600}</destination>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <version/>
                <logLevel/>
                <loggerName/>
                <threadName/>
                <message/>
                <mdc/>
                <logstashMarkers/>
                <stackTrace/>
                <pattern>
                    <pattern>
                        {
                            "appName": "${springAppName}"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <!-- Profile-based Logging Configuration -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="Console" />
            <appender-ref ref="ELK" />
        </root>
    </springProfile>

    <springProfile name="staging">
        <root level="INFO">
            <appender-ref ref="Console" />
            <appender-ref ref="File" />
            <appender-ref ref="ELK" />
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="File" />
            <appender-ref ref="ELK" />
        </root>
    </springProfile>

    <!-- Default root logger when no profile is active -->
    <root level="INFO">
        <appender-ref ref="Console" />
        <appender-ref ref="ELK" />
    </root>

</configuration>
